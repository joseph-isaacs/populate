     }
 
@@ -59,7 +96,7 @@ impl RowRandomInt {
 
     /// Instantiates a new seed for the next random value.
     pub fn next_rand(&mut self) -> i64 {
-        self.seed = (self.seed * Self::MULTIPLIER) % Self::MODULUS;
+        self.seed = mod_modulus(self.seed * Self::MULTIPLIER);
         self.usage += 1;
         self.seed
     }
@@ -83,16 +120,28 @@ impl RowRandomInt {
 
     /// Advances the seed value by the number of uses.
     fn advance_seed(&mut self, count: i64) {
-        let mut multiplier = Self::MULTIPLIER;
-        let mut count = count;
+        if count <= 0 {
+            return;
+        }
+        if count != self.jump_count {
+            self.jump_multiplier = Self::multiplier_pow(count);
+            self.jump_count = count;
+        }
+        self.seed = mod_modulus((self.seed % Self::MODULUS) * self.jump_multiplier);
+    }
 
+    /// `MULTIPLIER^count mod MODULUS` by square-and-multiply.
+    fn multiplier_pow(mut count: i64) -> i64 {
+        let mut result = 1;
+        let mut multiplier = Self::MULTIPLIER;
         while count > 0 {
             if count % 2 != 0 {
-                self.seed = (multiplier * self.seed) % Self::MODULUS;
+                result = (multiplier * result) % Self::MODULUS;
             }
             count /= 2;
             multiplier = (multiplier * multiplier) % Self::MODULUS;
         }
+        result
     }
 }
 
@@ -522,6 +571,46 @@ impl<'a> RandomStringSequence<'a> {
     }
 
     pub fn next_value(&mut self) -> StringSequenceInstance<'a> {
+        let all = self.distribution.get_values();
+        let count = self.count as usize;
+        if count > Self::SPARSE_MAX_COUNT {
+            return self.next_value_full_shuffle();
+        }
+
+        // Partial Fisher-Yates over `all`, without copying it: only the first
+        // `count` positions are read back, so record just the positions each
+        // swap changed (`moved[k] = (position, index into all)`) and look
+        // others up as the identity. Same draws, same result as
+        // `next_value_full_shuffle`, without a per-row copy of the list.
+        let mut moved = [(0usize, 0usize); Self::SPARSE_MAX_COUNT];
+        let at = |moved: &[(usize, usize)], position: usize| {
+            moved
+                .iter()
+                .rev()
+                .find(|(p, _)| *p == position)
+                .map_or(position, |(_, index)| *index)
+        };
+        let mut values = Vec::with_capacity(count);
+        for current_position in 0..count {
+            let swap_position = self
+                .inner
+                .next_int(current_position as i32, all.len() as i32 - 1)
+                as usize;
+            let current = at(&moved[..current_position], current_position);
+            let swapped = at(&moved[..current_position], swap_position);
+            values.push(all[swapped]);
+            // `current_position` is never read again; `swap_position` now
+            // holds what was at `current_position`.
+            moved[current_position] = (swap_position, current);
+        }
+        StringSequenceInstance { values }
+    }
+
+    /// Longest sequence handled without copying the distribution's values.
+    const SPARSE_MAX_COUNT: usize = 16;
+
+    /// Reference implementation: shuffle a full copy, keep the first `count`.
+    fn next_value_full_shuffle(&mut self) -> StringSequenceInstance<'a> {
         // Get all values from the distribution
         let mut values: Vec<&str> = self.distribution.get_values().to_vec();
 
@@ -536,8 +625,9 @@ impl<'a> RandomStringSequence<'a> {
             values.swap(current_position as usize, swap_position);
         }
 
-        // Keep only the first 'count' values, and join them with spaces
+        // Truncate to the desired count
         values.truncate(self.count as usize);
+
         StringSequenceInstance { values }
     }
 
