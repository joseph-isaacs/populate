+/// Route parent filters through a window operator.
+///
+/// A window operator outputs its input columns at their input positions,
+/// followed by one column per window expression. A filter that only references
+/// columns every window expression partitions by keeps or drops whole
+/// partitions, so the window values of the rows it keeps are unchanged. Such a
+/// filter can be evaluated below the window instead. Filters on any other
+/// column, including the window columns, stay above.
+pub(crate) fn gather_window_filters_for_pushdown(
+    window_expr: &[Arc<dyn WindowExpr>],
+    input: &Arc<dyn ExecutionPlan>,
+    parent_filters: &[Arc<dyn PhysicalExpr>],
+) -> Result<FilterDescription> {
+    let mut partition_columns: Option<HashSet<usize>> = None;
+    for expr in window_expr {
+        let columns: HashSet<usize> = expr
+            .partition_by()
+            .iter()
+            .filter_map(|e| e.downcast_ref::<Column>().map(Column::index))
+            .collect();
+        partition_columns = Some(match partition_columns {
+            None => columns,
+            Some(previous) => previous.intersection(&columns).copied().collect(),
+        });
+    }
+    let column_mapping: HashMap<usize, usize> = partition_columns
+        .unwrap_or_default()
+        .into_iter()
+        .map(|index| (index, index))
+        .collect();
+    let child = ChildFilterDescription::from_child_with_column_mapping(
+        parent_filters,
+        column_mapping,
+        input,
+    )?;
+    Ok(FilterDescription::new().with_child(child))
