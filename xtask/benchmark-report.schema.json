{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generator benchmark reports: v1 minima and v2 medians with flush timings",
  "description": "Engine-neutral process wall times and output-file byte counts. Complete means the requested matrix finished, not that every sample succeeded.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "started_at_unix_seconds": {
      "type": "number",
      "minimum": 0
    },
    "finished_at_unix_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "complete": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "revision",
        "worktree_dirty"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "os_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "logical_cpus": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "rustc": {
          "type": [
            "string",
            "null"
          ]
        },
        "cargo": {
          "type": [
            "string",
            "null"
          ]
        },
        "rustflags": {
          "type": [
            "string",
            "null"
          ]
        },
        "cargo_encoded_rustflags": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_profile": {
          "type": "string"
        },
        "output_directory": {
          "type": "string"
        },
        "ldbc_resources": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "os",
        "architecture",
        "os_version",
        "cpu",
        "memory_bytes",
        "logical_cpus",
        "rustc",
        "cargo",
        "rustflags",
        "cargo_encoded_rustflags",
        "build_profile",
        "output_directory",
        "ldbc_resources"
      ]
    },
    "invocation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "threads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "generators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0
        },
        "statistic": {
          "enum": [
            "min",
            "median"
          ]
        },
        "max_runs": {
          "type": "integer",
          "minimum": 1
        },
        "noise_threshold": {
          "type": "number",
          "minimum": 0
        },
        "sync_output": {
          "type": "boolean"
        }
      },
      "required": [
        "scales",
        "threads",
        "generators",
        "formats",
        "runs",
        "warmup_runs",
        "statistic"
      ]
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/engine"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "engine": {
            "type": "string"
          },
          "workload": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "engine",
          "workload",
          "reason"
        ]
      }
    },
    "$schema": {
      "type": "string"
    },
    "specification": {
      "type": "object",
      "description": "Machine-readable measurement specification, storage/build provenance and output-equivalence evidence. Producer-specific details are allowed within this object.",
      "properties": {
        "methodology": {
          "type": "object"
        },
        "storage": {
          "type": "object"
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "methodology",
        "storage",
        "validation"
      ]
    }
  },
  "required": [
    "schema_version",
    "started_at_unix_seconds",
    "finished_at_unix_seconds",
    "complete",
    "source",
    "environment",
    "invocation",
    "configuration",
    "engines",
    "measurements",
    "skipped"
  ],
  "$defs": {
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "revision"
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "workload": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "description": "Thread setting passed to this engine, or 1 for a single-threaded engine with no thread option."
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "program": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stdout_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Explicit environment overrides for this command; absent means no overrides."
            },
            "cwd": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "program",
            "args",
            "stdout_file"
          ]
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sample"
          },
          "description": "All timed attempts in execution order for this engine and configuration."
        },
        "summary": {
          "$ref": "#/$defs/summary",
          "description": "Selected summary with medians/ranges in v2; null if any timed attempt failed. Median bytes are independent of timing and rounded down for an even count."
        },
        "sink": {
          "enum": [
            "memory",
            "file",
            "discard"
          ],
          "description": "Distinguishes in-memory Arrow, encoded file output, and encoded bytes discarded without storage."
        },
        "variant": {
          "type": "string",
          "description": "Distinguishes repeated comparison groups or dataset variants."
        },
        "validation_status": {
          "enum": [
            "passed",
            "mismatch",
            "not_run",
            "partial"
          ],
          "description": "Execution success does not establish output equivalence."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "engine",
        "workload",
        "scale",
        "size",
        "format",
        "threads",
        "command",
        "samples",
        "summary"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "samples": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "error"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "summary": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "sample": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "ok"
            },
            "wall_time_seconds": {
              "type": "number",
              "minimum": 0,
              "description": "Monotonic elapsed process wall time in seconds; no display rounding."
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Sum of generated file sizes in bytes; zero for in-memory Arrow generation. Not peak memory."
            },
            "flush_time_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "null when file flush was not measured; flushed wall time is process wall plus the separately measured flush."
            },
            "flushed_wall_time_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "null when file flush was not measured; flushed wall time is process wall plus the separately measured flush."
            },
            "user_cpu_seconds": {
              "type": "number",
              "minimum": 0
            },
            "system_cpu_seconds": {
              "type": "number",
              "minimum": 0
            },
            "peak_rss_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "trial": {
              "type": "integer",
              "minimum": 0
            },
            "started_at": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "status",
            "wall_time_seconds",
            "output_bytes"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "error"
          ]
        }
      ]
    },
    "summary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statistic": {
              "enum": [
                "min",
                "median"
              ]
            },
            "wall_time_seconds": {
              "type": "number",
              "minimum": 0
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "min_wall_time_seconds": {
              "type": "number",
              "minimum": 0
            },
            "max_wall_time_seconds": {
              "type": "number",
              "minimum": 0
            },
            "flush_time_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "flushed_wall_time_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "statistic",
            "wall_time_seconds",
            "output_bytes"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "statistic": {
                    "const": "median"
                  }
                }
              },
              "then": {
                "required": [
                  "min_wall_time_seconds",
                  "max_wall_time_seconds"
                ]
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "finished_at_unix_seconds": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "finished_at_unix_seconds": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "specification"
        ],
        "properties": {
          "configuration": {
            "properties": {
              "statistic": {
                "const": "median"
              }
            },
            "required": [
              "max_runs",
              "noise_threshold",
              "sync_output"
            ]
          },
          "measurements": {
            "items": {
              "properties": {
                "summary": {
                  "properties": {
                    "statistic": {
                      "const": "median"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "configuration": {
            "properties": {
              "statistic": {
                "const": "min"
              }
            }
          },
          "measurements": {
            "items": {
              "properties": {
                "summary": {
                  "properties": {
                    "statistic": {
                      "const": "min"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
