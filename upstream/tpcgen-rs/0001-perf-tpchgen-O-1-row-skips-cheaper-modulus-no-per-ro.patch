 tpchgen/src/random.rs | 166 ++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 160 insertions(+), 6 deletions(-)

diff --git a/tpchgen/src/random.rs b/tpchgen/src/random.rs
index f39a83b..d9e61a7 100644
--- a/tpchgen/src/random.rs
+++ b/tpchgen/src/random.rs
@@ -3,11 +3,46 @@
 use crate::{distribution::Distribution, text::TextPool};
 use std::fmt::Display;
 
-#[derive(Default, Debug, Clone, Copy, PartialEq, Eq)]
+#[derive(Default, Debug, Clone, Copy)]
 pub struct RowRandomInt {
     seed: i64,
     usage: i32,
     seeds_per_row: i32,
+    /// Memoized `MULTIPLIER^jump_count mod MODULUS` for [`Self::advance_seed`].
+    /// Rows nearly always leave the same number of seeds unused, so
+    /// `row_finished` becomes one multiply instead of a square-and-multiply
+    /// loop. `jump_count == 0` means nothing is cached (`advance_seed(0)` is a
+    /// no-op and never consults the cache).
+    jump_count: i64,
+    jump_multiplier: i64,
+}
+
+/// Equality ignores the jump cache: it never changes the generated values.
+impl PartialEq for RowRandomInt {
+    fn eq(&self, other: &Self) -> bool {
+        self.seed == other.seed
+            && self.usage == other.usage
+            && self.seeds_per_row == other.seeds_per_row
+    }
+}
+
+impl Eq for RowRandomInt {}
+
+/// `x mod (2^31 - 1)` for `0 <= x < 2^62`.
+///
+/// Since `2^31 ≡ 1 (mod 2^31 - 1)`, the high bits can be folded onto the low
+/// bits with a shift and add, which is cheaper than the multiply-high and
+/// fix-up sequence the compiler emits for `%` by a constant. Two folds bring
+/// any value below `2^62` into `[0, 2^31]`, and one conditional subtract
+/// finishes.
+#[inline(always)]
+fn mod_modulus(x: i64) -> i64 {
+    debug_assert!((0..1 << 62).contains(&x));
+    const M: u64 = RowRandomInt::MODULUS as u64;
+    let x = x as u64;
+    let s = (x & M) + (x >> 31);
+    let s = (s & M) + (s >> 31);
+    (if s >= M { s - M } else { s }) as i64
 }
 
 impl RowRandomInt {
@@ -25,6 +60,7 @@ impl RowRandomInt {
             seed,
             usage: 0,
             seeds_per_row,
+            ..Self::default()
         }
     }
 
@@ -41,6 +77,7 @@ impl RowRandomInt {
             seed: seed + column_number as i64 * (Self::MODULUS / 799),
             seeds_per_row,
             usage: 0,
+            ..Self::default()
