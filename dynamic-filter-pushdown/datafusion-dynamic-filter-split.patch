diff --git a/datafusion/sqllogictest/test_files/dynamic_filter_split_pushdown.slt b/datafusion/sqllogictest/test_files/dynamic_filter_split_pushdown.slt
new file mode 100644
index 0000000..0a58f46
--- /dev/null
+++ b/datafusion/sqllogictest/test_files/dynamic_filter_split_pushdown.slt
@@ -0,0 +1,215 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: See the NOTICE file distributed with this work for additional information regarding copyright ownership
+# SPDX-FileContributor: Licensed to the Apache Software Foundation (ASF) under one or more contributor license agreements
+
+# Dynamic filters that reach scans which the full filter cannot reach:
+# 1. A TopK on several sort keys also pushes a filter on its first sort key alone
+# 2. A join on several keys also pushes one range filter per key
+# 3. Window operators pass filters on columns every window expression partitions by
+
+statement ok
+set datafusion.execution.target_partitions = 1;
+
+statement ok
+CREATE TABLE fact_v(f_dim1 INT, f_dim2 INT, f_qty INT) AS VALUES
+(1, 10, 5), (1, 20, 6), (2, 10, 7), (2, 20, 8), (3, 30, 9), (4, 40, 10), (5, 50, 11);
+
+statement ok
+CREATE TABLE dim1_v(d1_key INT, d1_name VARCHAR, d1_group INT) AS VALUES
+(1, 'a', 1), (2, 'b', 1), (3, 'c', 2), (4, 'd', 2), (5, 'e', 3);
+
+statement ok
+CREATE TABLE dim2_v(d2_key INT, d2_code VARCHAR, d2_group INT) AS VALUES
+(10, 'x', 1), (20, 'y', 1), (30, 'z', 2), (40, 'w', 2), (50, 'v', 3);
+
+query I
+COPY fact_v TO 'test_files/scratch/dynamic_filter_split_pushdown/fact.parquet' STORED AS PARQUET;
+----
+7
+
+query I
+COPY dim1_v TO 'test_files/scratch/dynamic_filter_split_pushdown/dim1.parquet' STORED AS PARQUET;
+----
+5
+
+query I
+COPY dim2_v TO 'test_files/scratch/dynamic_filter_split_pushdown/dim2.parquet' STORED AS PARQUET;
+----
+5
+
+statement ok
+CREATE EXTERNAL TABLE fact STORED AS PARQUET
+LOCATION 'test_files/scratch/dynamic_filter_split_pushdown/fact.parquet';
+
+statement ok
+CREATE EXTERNAL TABLE dim1 STORED AS PARQUET
+LOCATION 'test_files/scratch/dynamic_filter_split_pushdown/dim1.parquet';
+
+statement ok
+CREATE EXTERNAL TABLE dim2 STORED AS PARQUET
+LOCATION 'test_files/scratch/dynamic_filter_split_pushdown/dim2.parquet';
+
+# 1. TopK on sort keys from two sides of a join: the full TopK filter references
+# both `d1_name` and `d2_code` and cannot pass the join, but the filter on the
+# first key, `d1_name`, reaches the dim1 scan.
+query TT
+EXPLAIN SELECT d1_name, d2_code, f_qty
+FROM fact JOIN dim1 ON f_dim1 = d1_key JOIN dim2 ON f_dim2 = d2_key
+ORDER BY d1_name, d2_code LIMIT 2;
+----
+logical_plan
+01)Sort: dim1.d1_name ASC NULLS LAST, dim2.d2_code ASC NULLS LAST, fetch=2
+02)--Projection: dim1.d1_name, dim2.d2_code, fact.f_qty
+03)----Inner Join: fact.f_dim2 = dim2.d2_key
+04)------Projection: fact.f_dim2, fact.f_qty, dim1.d1_name
+05)--------Inner Join: fact.f_dim1 = dim1.d1_key
+06)----------TableScan: fact projection=[f_dim1, f_dim2, f_qty]
+07)----------TableScan: dim1 projection=[d1_key, d1_name]
+08)------TableScan: dim2 projection=[d2_key, d2_code]
+physical_plan
+01)SortExec: TopK(fetch=2), expr=[d1_name@0 ASC NULLS LAST, d2_code@1 ASC NULLS LAST], preserve_partitioning=[false]
+02)--HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(d2_key@0, f_dim2@0)], projection=[d1_name@4, d2_code@1, f_qty@3]
+03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/dynamic_filter_split_pushdown/dim2.parquet]]}, projection=[d2_key, d2_code], file_type=parquet
+04)----HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(d1_key@0, f_dim1@0)], projection=[f_dim2@3, f_qty@4, d1_name@1]
+05)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/dynamic_filter_split_pushdown/dim1.parquet]]}, projection=[d1_key, d1_name], file_type=parquet, predicate=DynamicFilter [ empty ], dynamic_rg_pruning=eligible
+06)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/dynamic_filter_split_pushdown/fact.parquet]]}, projection=[f_dim1, f_dim2, f_qty], file_type=parquet, predicate=DynamicFilter [ empty ] AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
+
+query TTI
+SELECT d1_name, d2_code, f_qty
+FROM fact JOIN dim1 ON f_dim1 = d1_key JOIN dim2 ON f_dim2 = d2_key
+ORDER BY d1_name, d2_code LIMIT 2;
+----
+a x 5
+a y 6
+
+query TTI
+SELECT d1_name, d2_code, f_qty
+FROM fact JOIN dim1 ON f_dim1 = d1_key JOIN dim2 ON f_dim2 = d2_key
+ORDER BY d1_name DESC, d2_code DESC LIMIT 3;
+----
+e v 11
+d w 10
+c z 9
+
+# A single sort key needs no separate first-key filter
+query TT
+EXPLAIN SELECT d1_name FROM dim1 ORDER BY d1_name LIMIT 2;
+----
+logical_plan
+01)Sort: dim1.d1_name ASC NULLS LAST, fetch=2
+02)--TableScan: dim1 projection=[d1_name]
+physical_plan
+01)SortExec: TopK(fetch=2), expr=[d1_name@0 ASC NULLS LAST], preserve_partitioning=[false]
+02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/dynamic_filter_split_pushdown/dim1.parquet]]}, projection=[d1_name], file_type=parquet, predicate=DynamicFilter [ empty ], sort_order_for_reorder=[d1_name@0 ASC NULLS LAST], dynamic_rg_pruning=eligible
+
+# 2. A join on two keys produced by different probe-side scans: the full filter
+# references both keys and cannot pass the inner join below, but each key's range
+# filter reaches the scan that produces it. Since `d1_group = d2_group`, the inner
+# join also transfers each of them to the other side.
+query TT
+EXPLAIN SELECT d1_name, d2_code
+FROM dim1 JOIN dim2 ON d1_group = d2_group
+JOIN (SELECT * FROM (VALUES (1, 2), (2, 2)) AS t(g1, g2)) AS s
+  ON s.g1 = d1_group AND s.g2 = d2_group;
+----
+logical_plan
+01)Projection: dim1.d1_name, dim2.d2_code
+02)--Inner Join: CAST(dim1.d1_group AS Int64) = s.g1, CAST(dim2.d2_group AS Int64) = s.g2
+03)----Inner Join: dim1.d1_group = dim2.d2_group
+04)------TableScan: dim1 projection=[d1_name, d1_group]
+05)------TableScan: dim2 projection=[d2_code, d2_group]
+06)----SubqueryAlias: s
+07)------SubqueryAlias: t
+08)--------Projection: column1 AS g1, column2 AS g2
+09)----------Values: (Int64(1), Int64(2)), (Int64(2), Int64(2))
+physical_plan
+01)HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(g1@0, CAST(dim1.d1_group AS Int64)@5), (g2@1, CAST(dim2.d2_group AS Int64)@4)], projection=[d1_name@2, d2_code@4]
+02)--ProjectionExec: expr=[column1@0 as g1, column2@1 as g2]
+03)----DataSourceExec: partitions=1, partition_sizes=[1]
+04)--ProjectionExec: expr=[d1_name@0 as d1_name, d1_group@1 as d1_group, d2_code@2 as d2_code, d2_group@3 as d2_group, CAST(d2_group@3 AS Int64) as CAST(dim2.d2_group AS Int64), CAST(d1_group@1 AS Int64) as CAST(dim1.d1_group AS Int64)]
+05)----HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(d1_group@1, d2_group@1)]
+06)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/dynamic_filter_split_pushdown/dim1.parquet]]}, projection=[d1_name, d1_group], file_type=parquet, predicate=DynamicFilter [ empty ] AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
+07)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/dynamic_filter_split_pushdown/dim2.parquet]]}, projection=[d2_code, d2_group], file_type=parquet, predicate=DynamicFilter [ empty ] AND DynamicFilter [ empty ] AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
+
+query TT rowsort
+SELECT d1_name, d2_code
+FROM dim1 JOIN dim2 ON d1_group = d2_group
+JOIN (SELECT * FROM (VALUES (1, 2), (2, 2)) AS t(g1, g2)) AS s
+  ON s.g1 = d1_group AND s.g2 = d2_group;
+----
+c w
+c z
+d w
+d z
+
+# 3. A join filter on the window's partition column passes the window
+query TT
+EXPLAIN SELECT w.f_dim1, w.total
+FROM (SELECT f_dim1, sum(f_qty) OVER (PARTITION BY f_dim1) AS total FROM fact) AS w
