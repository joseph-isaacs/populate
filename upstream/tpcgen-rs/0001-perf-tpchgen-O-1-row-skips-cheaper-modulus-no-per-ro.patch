 #[cfg(test)]
 mod test {
     use super::*;
+    use crate::distribution::Distributions;
     use std::collections::HashSet;
+
+    /// The original `advance_seed`: square-and-multiply on the seed.
+    fn advance_seed_reference(mut seed: i64, mut count: i64) -> i64 {
+        let mut multiplier = RowRandomInt::MULTIPLIER;
+        while count > 0 {
+            if count % 2 != 0 {
+                seed = (multiplier * seed) % RowRandomInt::MODULUS;
+            }
+            count /= 2;
+            multiplier = (multiplier * multiplier) % RowRandomInt::MODULUS;
+        }
+        seed
+    }
+
+    #[test]
+    fn mod_modulus_matches_remainder() {
+        const M: i64 = RowRandomInt::MODULUS;
+        for x in [0, 1, M - 1, M, M + 1, 2 * M, 2 * M + 1, (1 << 62) - 1] {
+            assert_eq!(mod_modulus(x), x % M, "{x}");
+        }
+        let mut state: u64 = 0x9E37_79B9_7F4A_7C15;
+        for _ in 0..1_000_000 {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            let x = (state >> 2) as i64; // [0, 2^62)
+            assert_eq!(mod_modulus(x), x % M, "{x}");
+        }
+    }
+
+    #[test]
+    fn memoized_row_jump_matches_square_and_multiply() {
+        // Rows using a varying number of their reserved seeds, so the jump
+        // count changes (cache misses) as well as repeats (cache hits).
+        let mut rng = RowRandomInt::new(709314158, 7);
+        let mut seed = 709314158;
+        for row in 0..10_000i64 {
+            let used = (row * 7 + row / 3) % 9; // 0..=8, sometimes > 7
+            for _ in 0..used {
+                rng.next_rand();
+                seed = seed * RowRandomInt::MULTIPLIER % RowRandomInt::MODULUS;
+            }
+            rng.row_finished();
+            seed = advance_seed_reference(seed, 7 - used);
+            assert_eq!(rng.seed, seed, "row {row}");
+        }
+        rng.advance_rows(123_456);
+        assert_eq!(rng.seed, advance_seed_reference(seed, 7 * 123_456));
+    }
+
+    #[test]
+    fn sparse_string_sequence_matches_full_shuffle() {
+        let colors = Distributions::static_default().part_colors();
+        for count in [1, 2, 5, 10, 16] {
+            let mut sparse = RandomStringSequence::new(709314158, count, colors);
+            let mut full = RandomStringSequence::new(709314158, count, colors);
+            for _ in 0..10_000 {
+                assert_eq!(sparse.next_value(), full.next_value_full_shuffle());
+                sparse.row_finished();
+                full.row_finished();
+            }
+        }
+    }
