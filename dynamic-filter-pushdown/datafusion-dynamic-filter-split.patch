+/// Whether `plan` contains an operator that may stop a filter on several
+/// columns while a filter on just one of those columns could still pass it.
+///
+/// Such operators are those with several inputs, such as joins and unions,
+/// which route a filter only to an input that produces all of its columns, and
+/// aggregates and windows, which pass filters on some of their output columns
+/// only. Operators that produce a dynamic filter over several columns use this
+/// to decide whether to also push narrower filters, which elsewhere would only
+/// repeat the wider one.
+pub(crate) fn may_split_multi_column_filter(
+    plan: &Arc<dyn crate::ExecutionPlan>,
+) -> bool {
+    let children = plan.children();
+    if children.len() > 1
+        || plan.is::<AggregateExec>()
+        || plan.is::<BoundedWindowAggExec>()
+        || plan.is::<WindowAggExec>()
+    {
+        return true;
+    }
+    children.into_iter().any(may_split_multi_column_filter)
+}
